# Client-side build variables. Vite embeds every VITE_* value in the public
# bundle, so never put API secrets, payment keys or signing material here.

# Tapsell Mediation zone IDs. Leave empty to disable that ad surface cleanly.
VITE_TAPSELL_REWARDED_ZONE_ID=
VITE_TAPSELL_BANNER_ZONE_ID=
VITE_TAPSELL_INTERSTITIAL_ZONE_ID=

# Reserved for the private online-room phase. The online mode is NOT shipped
# yet; these values are unused until the server and client are implemented.
VITE_API_BASE_URL=
VITE_SOCKET_URL=

# Server-only values (never prefix these with VITE_).
PORT=3000
NODE_ENV=development

# Read by android/app/build.gradle (or android/local.properties), not by Vite.
# TAPSELL_MEDIATION_APP_ID=
